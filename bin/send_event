#!/bin/bash

# Check if an RFID ID is provided
if [ -z "$1" ]; then
  echo "Usage: $0 <RFID_ID>"
  exit 1
fi

# Set variables
RFID_ID="$1"
LOCATION="$2"
AT="$3"
API_URL="http://localhost:5000/api/tracking_events"

# Escape JSON properly using printf
JSON_PAYLOAD=$(printf '{"rfid_id": "%s", "location": "%s", "scanned_at": "%s", "metadata": {}}' "$RFID_ID" "$LOCATION" "$AT")

# Send the POST request
curl -X POST "$API_URL" \
     -H "Content-Type: application/json" \
     -d "$JSON_PAYLOAD" | jq .

# Print a success message
echo -e "\nTracking event for RFID ID: $RFID_ID sent successfully!"
