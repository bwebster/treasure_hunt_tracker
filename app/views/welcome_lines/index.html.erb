<div class="container pt-3 mt-5">
  <div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
      <%= render partial: "flash" %>

      <div class="card shadow-sm">
        <div class="card-header">
          <h4>Welcome Lines</h4>
        </div>
        <div class="card-body">
          <div class="py-3">
            Welcome lines are used in registration mode when sound is enabled (click the speaker icon).
            When you assign a username to a tag, it will pick a random welcome line and play it,
            filling in the variables with the correct information.
          </div>

          <div class="text-end mb-3">
            <%= link_to "New Welcome Line", new_welcome_line_path, class: "btn btn-sm btn-primary" %>
          </div>

          <% if @welcome_lines.any? %>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                <tr>
                  <th>Text</th>
                </tr>
                </thead>
                <tbody>
                <% @welcome_lines.each do |wl| %>
                  <tr>
                    <td>
                      <%= link_to wl.text, edit_welcome_line_path(wl) %>
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted">No welcome lines have been added.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
