<div class="container pt-3 mt-5">
  <%= render partial: "flash" %>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to "New Welcome Line", new_welcome_line_path, class: "btn btn-sm btn-primary" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Welcome Lines</h4>
    </div>
    <div class="card-body">
      <% if @welcome_lines.any? %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
            <tr>
              <th>Text</th>
            </tr>
            </thead>
            <tbody>
            <% @welcome_lines.each do |wl| %>
              <tr>
                <td>
                  <%= link_to wl.text, edit_welcome_line_path(wl) %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted">No welcome lines have been added.</p>
      <% end %>
    </div>
  </div>
</div>
