<% content_for :title, "New welcome line" %>

<div class="container pt-3 mt-5">
  <div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-header">
          <h4>New Welcome Line</h4>
        </div>

        <div class="card-body">
          <% if @welcome_line.errors.any? %>
            <div class="alert alert-danger">
              <h5><i class="bi bi-exclamation-triangle"></i> Please fix the following:</h5>
              <ul>
                <% @welcome_line.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= render "form", welcome_line: @welcome_line %>
        </div>
      </div>
    </div>
  </div>
</div>
