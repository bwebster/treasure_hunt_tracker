<table class="table table-striped">
  <thead>
  <tr>
    <th>Username</th>
    <td>Type</td>
    <th>Non-test Events<br/>with a Scan</th>
    <th>All Events<br/> with a Scan</th>
    <th>Number Total Scan</th>
  </tr>
  </thead>
  <tbody>
  <% data.each do |row| %>
  <tr>
    <td>
      <% if row["type"] == "user" %>
        <%= link_to row["username"], edit_user_path(row["id"]) %>
      <% else %>
        <%= link_to row["username"], edit_rfid_tag_path(row["id"]) %>
      <% end %>
    </td>
    <td><%= row["type"] %></td>
    <td><%= row["non_test_events_count"] %></td>
    <td><%= row["event_count"] %></td>
    <td><%= row["total_count"] %></td>
  </tr>
  <% end %>
  </tbody>
</table>