<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Life.Church At The Movies" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <%# Includes all stylesheet files in app/assets/stylesheets %>
  <link href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Oxanium:wght@500;700&display=swap" rel="stylesheet">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css", media: "all" %>
  <%#= javascript_include_tag "https://www.gstatic.com/charts/loader.js" %>
  <%#= javascript_include_tag "chartkick" %>
</head>

<body class="<%= 'hide-navbar' if current_page?(register_path) || current_page?(root_path) || current_page?(display_path) %>">

<div class="navbar-hover-area"></div>
<nav class="navbar navbar-expand-lg fixed-top navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">
      <i class="bi bi-stars"></i> At The Movies
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <%= link_to "Leader Board", root_path(anchor: "scores"), class: "nav-link #{'active' if current_page?(root_path)}" %>
        </li>
        <li class="nav-item">
          <%= link_to "Admin", admin_path, class: "nav-link #{'active' if current_page?(admin_path)}" %>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-gear-fill"></i>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li class="dropdown-item">
              <%= link_to "Registration", register_path, class: "dropdown-item" %>
            </li>
            <li class="dropdown-item">
              <%= link_to "RFID Tags", rfid_tags_path, class: "dropdown-item" %>
            </li>
            <li class="dropdown-item">
              <%= link_to "Users", users_path, class: "dropdown-item" %>
            </li>
            <li class="dropdown-item">
              <%= link_to "Events", events_path, class: "dropdown-item" %>
            </li>
            <li class="dropdown-item">
              <%= link_to "Welcome Lines", welcome_lines_path, class: "dropdown-item" %>
            </li>
            <li class="dropdown-item">
              <%= link_to "Voice Settings", voice_settings_path, class: "dropdown-item" %>
            </li>
            <li class="dropdown-item">
              <%= link_to "Tracking Events", tracking_events_path, class: "dropdown-item" %>
            </li>
            <li class="dropdown-item">
              <%= link_to "Tracking Event Activity", activity_tracking_events_path, class: "dropdown-item" %>
            </li>
            <li class="dropdown-item">
              <%= link_to "Scores", scores_path, class: "dropdown-item" %>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>

<%= yield %>

<footer class="text-center py-3 text-muted small">
  Version: <%= ENV["HEROKU_RELEASE_VERSION"] || "Local Dev" %>
</footer>

</body>
</html>
