<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Leader Board</h4>
    </div>

    <div class="card-body">
      <ul class="nav nav-tabs" id="leaderboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <a class="nav-link active" id="scores-tab" data-bs-toggle="tab" href="#scores" role="tab" aria-controls="scores" aria-selected="true">
            Scores
          </a>
        </li>
        <li class="nav-item" role="presentation">
          <a class="nav-link" id="users-tab" data-bs-toggle="tab" href="#users" role="tab" aria-controls="users" aria-selected="true">
            Users
          </a>
        </li>
        <li class="nav-item" role="presentation">
          <a class="nav-link" id="rfid-tab" data-bs-toggle="tab" href="#rfid" role="tab" aria-controls="rfid" aria-selected="false">
            RFID Tags
          </a>
        </li>
      </ul>

      <div class="tab-content mt-3" id="leaderboardTabsContent">
        <!-- Scores Tab -->
        <div class="tab-pane fade show active" id="scores" role="tabpanel" aria-labelledby="scores-tab">
          <table class="table table-striped">
            <thead>
            <tr>
              <th>Rank</th>
              <th>Tag</th>
              <th>Level</th>
              <th>Title</th>
              <th>Score</th>
            </thead>
            <tbody>
            <% @scores.each_with_index do |score, index| %>
              <tr>
                <td><%= score.rank.ordinalize %></td>
                <td><%= score.rfid_tag.label %></td>
                <td><%= leveling(score.score).level %></td>
                <td><%= leveling(score.score).title %></td>
                <td><%= number_with_delimiter(score.score) %></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>

        <!-- Users Tab -->
        <div class="tab-pane fade" id="users" role="tabpanel" aria-labelledby="users-tab">
          <table class="table table-striped">
            <thead>
            <tr>
              <th>Rank</th>
              <th>Username</th>
              <th>Scanned Locations</th>
              <th>Total Locations</th>
              <th>Completion %</th>
            </thead>
            <tbody>
            <% @results.each_with_index do |user, index| %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= user.username || "Anonymous" %> <%= user.last_name %></td>
                <td><%= user.scanned_locations %></td>
                <td><%= user.total_locations %></td>
                <td style="min-width: 150px;">
                  <div class="progress border border-success-subtle" style="height: 20px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: <%= user.completion_percentage || 0 %>%;">
                      <%= number_to_percentage(user.completion_percentage || 0, precision: 0) %>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>

        <!-- RFID Tags Tab -->
        <div class="tab-pane fade" id="rfid" role="tabpanel" aria-labelledby="rfid-tab">
          <table class="table table-striped align-middle">
            <thead>
            <tr>
              <th>Rank</th>
              <th>RFID Tag</th>
              <th>Username</th>
              <th>Scanned Locations</th>
              <th>Total Locations</th>
              <th>Completion %</th>
            </tr>
            </thead>
            <tbody>
            <% @rfid_tags.each_with_index do |rfid_tag, index| %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= rfid_tag.label %></td>
                <td><%= rfid_tag.user&.username %></td>
                <td><%= rfid_tag.scanned_locations %></td>
                <td><%= rfid_tag.total_locations %></td>
                <td style="min-width: 150px;">
                  <div class="progress border border-success-subtle" style="height: 20px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: <%= rfid_tag.completion_percentage || 0 %>%;">
                      <%= number_to_percentage(rfid_tag.completion_percentage || 0, precision: 0) %>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
