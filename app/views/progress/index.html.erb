<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Leader Board</h4>
    </div>

    <div class="card-body">
      <table class="table table-striped">
        <thead>
        <tr>
          <th>Rank</th>
          <th>Tag</th>
          <th>Level</th>
          <th>Title</th>
          <th>Score</th>
        </thead>
        <tbody>
        <% @scores.each_with_index do |score, index| %>
          <tr>
            <td><%= score.rank.ordinalize %></td>
            <td><%= score.rfid_tag.user&.username || score.rfid_tag.label %></td>
            <td><%= leveling(score.score).level %></td>
            <td><%= leveling(score.score).title %></td>
            <td><%= number_with_delimiter(score.score) %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        setTimeout(() => {
            location.reload();
        }, 20000); // 20 seconds
    });
</script>
