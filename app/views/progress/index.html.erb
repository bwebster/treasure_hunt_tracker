<div class="container mt-2">
  <div class="card shadow-sm" style="height: 86vh;">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h4 class="mb-0">Leader Board</h4>
      <div class="d-flex align-items-center">
        <span id="page-number" class="text-muted me-3">Page 1</span>
        <button id="play-pause-btn" class="btn btn-sm text-muted">
          <i class="bi bi-pause"></i>
        </button>
      </div>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table id="paginated-table" class="table table-striped pb-1">
          <thead>
          <tr>
            <th>Rank</th>
            <th>Tag</th>
            <th>Level</th>
            <th>Score</th>
          </thead>
          <tbody>
          <% @scores.each_with_index do |score, index| %>
            <tr>
              <td><%= score.rank.ordinalize %></td>
              <td><%= score.rfid_tag.user&.username || score.rfid_tag.label %></td>
              <td>
                <%= leveling(score.score).level %> - <%= leveling(score.score).title %>
              </td>
              <td><%= number_with_delimiter(score.score) %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
    document.addEventListener("turbo:load", () => {
        const table = document.getElementById("paginated-table");
        const pageNumber = document.getElementById("page-number");
        const playPauseBtn = document.getElementById("play-pause-btn");
        if (!table || !pageNumber || !playPauseBtn) return;

        const rows = table.querySelectorAll("tbody tr");
        const rowHeight = 40;
        const headerHeight = 100;
        const cardPadding = 50;
        const screenHeight = window.innerHeight;
        let rowsPerPage = Math.floor((screenHeight * 0.9 - headerHeight - cardPadding) / rowHeight);

        let currentPage = 0;
        const totalPages = Math.ceil(rows.length / rowsPerPage);
        let isPaused = false;
        let interval;

        function showPage(page) {
            rows.forEach((row, index) => {
                row.style.display = index >= page * rowsPerPage && index < (page + 1) * rowsPerPage ? "table-row" : "none";
            });
            pageNumber.textContent = `Page ${page + 1}`;
        }

        function nextPage() {
            if (isPaused) return;
            currentPage++;
            if (currentPage >= totalPages) {
                location.reload();
            } else {
                showPage(currentPage);
            }
        }

        function togglePlayPause() {
            isPaused = !isPaused;
            playPauseBtn.innerHTML = isPaused ? '<i class="bi bi-play"></i>' : '<i class="bi bi-pause"></i>';
        }

        showPage(currentPage);
        interval = setInterval(nextPage, 6000);

        playPauseBtn.addEventListener("click", togglePlayPause);

        window.addEventListener("resize", () => {
            rowsPerPage = Math.floor((window.innerHeight * 0.9 - headerHeight - cardPadding) / rowHeight);
            showPage(currentPage);
        });
    });
</script>
