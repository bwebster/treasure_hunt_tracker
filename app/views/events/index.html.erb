<div class="container pt-3 mt-5">
  <%= render partial: "flash" %>

  <div class="d-flex justify-content-between align-items-center mb-3 mt-10">
    <%= link_to "New Event", new_event_path, class: "btn btn-sm btn-primary" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Event List</h4>
    </div>
    <div class="card-body">
      <% if @events.any? %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
            <tr>
              <th>Name</th>
              <th>Date</th>
              <th>Test Event?</th>
              <th>Locations</th>
            </tr>
            </thead>
            <tbody>
            <% @events.each do |event| %>
              <tr>
                <td>
                  <%= link_to event.name, edit_event_path(event) %>
                </td>
                <td><%= event.date.strftime("%B %d, %Y") %></td>
                <td>
                  <% if event.test_event? %>
                    <i class="bi bi-check-circle-fill"></i> Test Event
                  <% end %>
                </td>
                <td>
                  <table class="table table-sm table-borderless mb-0">
                    <tbody>
                    <% event.locations.order(number: :asc).each do |loc| %>
                      <tr>
                        <td>#<%= loc.number %></td>
                        <td>
                          <%= loc.name %>
                          <% if loc.registration? %>
                            <button id="toggle-listening" data-location-id="<%= loc.id %>" class="toggle-registration btn btn-sm btn-primary p-0 px-1 mx-2">Enter Registration Mode</button>
                          <% end %>
                          <% if loc.display? %>
                            <button id="toggle-listening" data-location-id="<%= loc.id %>" class="toggle-display btn btn-sm btn-primary p-0 px-1 mx-2">Enter Display Mode</button>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                    </tbody>
                  </table>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted">No events found.</p>
      <% end %>
    </div>
  </div>
</div>
