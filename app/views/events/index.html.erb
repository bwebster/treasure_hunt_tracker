<div class="container mt-5">
  <%= render partial: "flash" %>

  <div class="d-flex justify-content-between align-items-center mb-3 mt-10">
    <%= link_to "New Event", new_event_path, class: "btn btn-sm btn-success" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Event List</h4>
    </div>
    <div class="card-body">
      <% if @events.any? %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
            <tr>
              <th>Name</th>
              <th>Date</th>
              <th>Locations</th>
              <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            <% @events.each do |event| %>
              <tr>
                <td>
                  <%= link_to event.name, edit_event_path(event) %>
                </td>
                <td><%= event.date.strftime("%B %d, %Y") %></td>
                <td>
                  <ul>
                    <% event.locations.each do |loc| %>
                      <li>
                        #<%= loc.number %> - <%= loc.name %>
                        <% if loc.registration? %>
                          <button id="toggle-listening" data-location-id="<%= loc.id %>" class="toggle-registration btn btn-sm btn-primary">Register</button>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </td>
                <td>
                  <%= link_to event_path(event),
                              method: :delete,
                              data: { turbo_method: :delete, confirm: "Are you sure?" },
                              class: "btn btn-link text-danger p-0" do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted">No events found.</p>
      <% end %>
    </div>
  </div>
</div>
