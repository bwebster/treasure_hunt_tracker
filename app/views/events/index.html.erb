<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to "New Event", new_event_path, class: "btn btn-success" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
      <h4>Event List</h4>
    </div>
    <div class="card-body">
      <% if @events.any? %>
        <table class="table table-striped">
          <thead>
          <tr>
            <th>Name</th>
            <th>Date</th>
            <th>Locations</th>
            <th>Actions</th>
          </tr>
          </thead>
          <tbody>
          <% @events.each do |event| %>
            <tr>
              <td><%= event.name %></td>
              <td><%= event.date.strftime("%B %d, %Y") %></td>
              <td>
                <ul>
                <% event.locations.each do |loc| %>
                  <li><%= loc.name %></li>
                <% end %>
                </ul>
              </td>
              <td>
                <%= link_to "Edit", edit_event_path(event), class: "btn btn-sm btn-warning" %>
                <%= form_with url: event_path(event), method: :delete, data: { confirm: "Are you sure?" }, class: "d-inline" do %>
                  <button type="submit" class="btn btn-sm btn-danger">
                    Delete
                  </button>
                <% end %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">No events found.</p>
      <% end %>
    </div>
  </div>
</div>
