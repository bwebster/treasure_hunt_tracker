<div class="container mt-5">

  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Edit Event</h4>
    </div>
    <div class="card-body">
      <% if @event.errors.any? %>
        <div class="alert alert-danger">
          <h5><i class="bi bi-exclamation-triangle"></i> Please fix the following:</h5>
          <ul>
            <% @event.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @event, local: true do |f| %>

        <div class="mb-3">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-control", required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :date, class: "form-label" %>
          <%= f.date_field :date, class: "form-control", required: true %>
        </div>

        <div class="text-end">
          <%= link_to "Cancel", events_path, class: "btn btn-secondary" %>
          <%= f.submit "Save", class: "btn btn-primary" %>
        </div>

      <% end %>
    </div>
  </div>

  <div class="card shadow-sm mt-4">
    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
      <h5>Locations</h5>
      <%= link_to "New Location", new_event_location_path(@event), class: "btn btn-light btn-sm" %>
    </div>
    <div class="card-body">
      <% if @event.locations.any? %>
        <table class="table table-striped">
          <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Registration Station</th>
            <th>Actions</th>
          </tr>
          </thead>
          <tbody>
          <% @event.locations.each do |location| %>
            <tr>
              <td><%= location.number %></td>
              <td><%= location.name %></td>
              <td>
                <% if location.registration? %>
                  Yes
                <% end %>
                </td>
              <td>
                <%= link_to "Edit", edit_event_location_path(@event, location), class: "btn btn-sm btn-warning" %>
                <%= form_with url: event_location_path(@event, location), method: :delete, data: { confirm: "Are you sure?" }, class: "d-inline" do %>
                  <button type="submit" class="btn btn-sm btn-danger">
                    Delete
                  </button>
                <% end %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">No locations found.</p>
      <% end %>
    </div>
  </div>
</div>
