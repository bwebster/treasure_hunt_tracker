<div class="container pt-3 mt-5">
  <%= render partial: "flash" %>

  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Edit Event</h4>
    </div>
    <div class="card-body">
      <% if @event.errors.any? %>
        <div class="alert alert-danger">
          <h5><i class="bi bi-exclamation-triangle"></i> Please fix the following:</h5>
          <ul>
            <% @event.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @event, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-control", required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :date, class: "form-label" %>
          <%= f.date_field :date, class: "form-control", required: true %>
        </div>

        <div class="text-end">
          <%= link_to "Cancel", events_path, class: "btn btn-secondary" %>
          <%= f.submit "Save", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5>Locations</h5>
      <%= link_to "New Location", new_event_location_path(@event), class: "btn btn-primary btn-sm" %>
    </div>
    <div class="card-body">
      <% if @event.locations.order(number: :asc).any? %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Registration Station</th>
              <th>Display Station</th>
              <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            <% @event.locations.each do |location| %>
              <tr>
                <td>
                  <%= location.number %>
                </td>
                <td>
                  <%= link_to location.name, edit_event_location_path(@event, location) %>
                </td>
                <td>
                  <% if location.registration? %>
                    Yes
                  <% end %>
                </td>
                <td>
                  <% if location.display? %>
                    Yes
                  <% end %>
                </td>
                <td>
                  <%= link_to event_location_path(@event, location),
                              method: :delete,
                              data: { turbo_method: :delete, confirm: "Are you sure?" },
                              class: "btn btn-link text-danger p-0" do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted">No locations found.</p>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5>Delete Event</h5>
    </div>
    <div class="card-body">
      <p class="text-muted">Deleting a event will also delete all locations, and cannot be undone.</p>

      <%= link_to event_path(@event),
                  method: :delete,
                  data: { turbo_method: :delete, confirm: "Are you sure?" },
                  class: "btn btn-link text-danger p-0" do %>
        <button class="btn btn-danger">Delete</button>
      <% end %>
    </div>
  </div>
</div>
