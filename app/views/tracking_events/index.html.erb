<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
      <h4>Tracking Events</h4>
    </div>
    <div class="card-body">
      <% if @tracking_events.any? %>
        <table class="table table-striped">
          <thead>
          <tr>
            <th>Scanned At</th>
            <th>Tag</th>
            <th>User</th>
            <th>Event</th>
            <th>Location</th>
            <th>Metadata</th>
          </tr>
          </thead>
          <tbody>
          <% @tracking_events.each do |tracking_event| %>
            <tr>
              <td><%= tracking_event.scanned_at.strftime("%B %d, %Y %H:%M:%S") %></td>
              <td>
                <span class="badge bg-info"><%= tracking_event.rfid_tag.tag_id %></span>
                <%= tracking_event.rfid_tag.label %>
              </td>
              <td>
                <% if tracking_event.rfid_tag.user.present? %>
                  <%= link_to tracking_event.rfid_tag.user.username, user_path(tracking_event.rfid_tag.user), class: "text-decoration-none" %>
                <% else %>
                  <span class="text-muted">Unassigned</span>
                <% end %>
              </td>
              <td>
                <% if tracking_event.event.present? %>
                  <%= link_to tracking_event.event.name, edit_event_path(tracking_event.event), class: "text-decoration-none" %>
                <% else %>
                  <span class="text-muted">No Event</span>
                <% end %>
              </td>
              <td>
                <% if tracking_event.location.present? %>
                  <%= tracking_event.location.name %>
                <% elsif tracking_event.submitted_location %>
                  <%= tracking_event.submitted_location %> (submitted)
                <% else %>
                  <span class="text-muted">No Location</span>
                <% end %>
              </td>
              <td>
                <% if tracking_event.metadata.present? %>
                  <pre class="mb-0"><%= tracking_event.metadata.to_json %></pre>
                <% else %>
                  <span class="text-muted">No Metadata</span>
                <% end %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">No tracking events found.</p>
      <% end %>
    </div>
  </div>
</div>
