<div class="container pt-3 mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Tracking Events</h4>
    </div>
    <div class="card-body">
      <% if @tracking_events.any? %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
            <tr>
              <th><%= sortable "scanned_at", default: true %></th>
              <th><%= sortable "rfid_tag.label", title: "Tag Label" %></th>
              <th><%= sortable "rfid_tag.tag_id", title: "Tag ID" %></th>
              <th><%= sortable "user.username", title: "User" %></th>
              <th><%= sortable "event.name", title: "Event" %></th>
              <th><%= sortable "location.name", title: "Location" %></th>
            </tr>
            </thead>
            <tbody>
            <% @tracking_events.each do |tracking_event| %>
              <tr>
                <td>
                  <%= human_time(tracking_event.scanned_at) %>
                </td>
                <td>
                  <%= tracking_event.rfid_tag.label %>
                </td>
                <td>
                  <%= tracking_event.rfid_tag.tag_id %>
                </td>
                <td>
                  <% if tracking_event.rfid_tag.user.present? %>
                    <%= link_to tracking_event.rfid_tag.user.username, user_path(tracking_event.rfid_tag.user), class: "text-decoration-none" %>
                  <% else %>
                    <span class="text-muted">Unassigned</span>
                  <% end %>
                </td>
                <td>
                  <% if tracking_event.event.present? %>
                    <%= link_to tracking_event.event.name, edit_event_path(tracking_event.event), class: "text-decoration-none" %>
                  <% else %>
                    <span class="text-muted">No Event</span>
                  <% end %>
                </td>
                <td>
                  <% if tracking_event.location.present? %>
                    #<%= tracking_event.submitted_location %> - <%= tracking_event.location.name %>
                  <% elsif tracking_event.submitted_location %>
                    (<%= tracking_event.submitted_location %>)
                  <% else %>
                    <span class="text-muted">No Location</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>

        <div class="d-flex justify-content-center">
          <%= paginate @tracking_events %>
        </div>
      <% else %>
        <p class="text-muted">No tracking events found.</p>
      <% end %>
    </div>
  </div>
</div>
