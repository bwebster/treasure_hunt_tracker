<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to "New User", new_user_path, class: "btn btn-sm btn-success" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Users</h4>
    </div>
    <div class="card-body">
      <% if @users.any? %>
        <table class="table table-striped">
          <thead>
          <tr>
            <th>Username</th>
            <th>Name</th>
            <th>Email</th>
            <th>RFID Tags</th>
            <th>Actions</th>
          </tr>
          </thead>
          <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.username %></td>
              <td><%= user.first_name %> <%= user.last_name %></td>
              <td><%= user.email || "N/A" %></td>
              <td>
                <% if user.rfid_tags.any? %>
                  <% user.rfid_tags.each do |tag| %>
                    <div><%= tag.tag_id %></div>
                  <% end %>
                <% else %>
                  <span class="text-muted">No tags</span>
                <% end %>
              </td>
              <td>
                <%= link_to "View", user_path(user), class: "btn btn-sm btn-info" %>
                <%= link_to "Edit", edit_user_path(user), class: "btn btn-sm btn-primary" %>
                <%= link_to "Delete", user_path(user), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">No users found.</p>
      <% end %>
    </div>
  </div>
</div>
