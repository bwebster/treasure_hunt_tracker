<div class="container mt-5">
  <div class="card shadow-sm">
    <%= render partial: "flash" %>

    <div class="card-header">
      <h4>Edit User</h4>
    </div>
    <div class="card-body">
      <%= form_with model: @user, url: user_path(@user), method: :patch, local: true do |f| %>

        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <%= f.label :username, class: "form-label" %>
              <%= f.text_field :username, class: "form-control", placeholder: "Enter Username", required: true %>
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, class: "form-control", placeholder: "Enter Email" %>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <%= f.label :first_name, class: "form-label" %>
              <%= f.text_field :first_name, class: "form-control", placeholder: "Enter First Name" %>
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <%= f.label :last_name, class: "form-label" %>
              <%= f.text_field :last_name, class: "form-control", placeholder: "Enter Last Name" %>
            </div>
          </div>
        </div>

        <div class="text-end">
          <%= link_to "Cancel", users_path, class: "btn btn-secondary" %>
          <%= f.submit "Save Changes", class: "btn btn-primary" %>
        </div>

      <% end %>

      <h5 class="mt-3">RFID Tags</h5>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= label_tag :rfid_tag_id, "Assigned", class: "form-label" %>
            <div>
            <% if @user.rfid_tags.any? %>
              <% @user.rfid_tags.each do |tag| %>
                <div class="text-white d-inline-flex align-items-center me-2">
                  <%= tag.tag_id %>
                  <%= button_to user_rfid_tag_path(@user, tag),
                                method: :delete,
                                data: { turbo_method: :delete, confirm: "Are you sure?" },
                                class: "border-0 bg-transparent text-white ms-1 p-0 d-inline-flex align-items-center" do %>
                    <i class="bi bi-trash text-danger"></i>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <p class="text-muted">No RFID tags assigned.</p>
            <% end %>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <% if @unassigned_rfid_tags.any? %>
            <%= form_with model: @user, url: user_path(@user), method: :patch, local: true do |f| %>
              <div class="mb-3">
                <%= label_tag :rfid_tag_id, "Assign an RFID Tag", class: "form-label" %>
                <%= f.collection_select :rfid_tag_id, @unassigned_rfid_tags, :id, :tag_id, { include_blank: "Unassigned" }, class: "form-select" %>
              </div>

              <div class="text-end">
                <%= f.submit "Save Changes", class: "btn btn-primary" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted">No unassigned RFID tags available.</p>
          <% end %>
        </div>
      </div>

      <h5 class="mt-3">Delete User</h5>

      <p class="text-muted">Deleting a user cannot be undone.</p>

      <%= link_to user_path(@user),
                  method: :delete,
                  data: { turbo_method: :delete, confirm: "Are you sure?" },
                  class: "btn btn-link text-danger p-0" do %>
        <button class="btn btn-danger">Delete</button>
      <% end %>
    </div>
  </div>
</div>
