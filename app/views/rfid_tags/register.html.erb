<div class="container">
  <div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-sm border-3" style="width: 400px;">
      <div class="card-header glow-text">
        <div class="d-flex justify-content-between">
          <div class="pt-1">Registration Station</div>

          <button id="speech-toggle" class="btn btn-sm">
            <i id="speech-icon" class="bi bi-volume-up-fill"></i>
          </button>
        </div>
      </div>
      <div class="card-body">
        <%= render partial: "flash" %>

        <p id="event-message" class="text-muted">Waiting for scan...</p>
      </div>
    </div>
  </div>
</div>
<script>
    document.addEventListener("turbo:load", () => {
        const btn = document.getElementById("speech-toggle");
        const icon = document.getElementById("speech-icon");

        // Initialize based on saved state
        const enabled = localStorage.getItem("speechEnabled") === "true";
        console.log("Registration loaded - voice enabled?", enabled);
        updateIcon(enabled);

        btn.addEventListener("click", () => {
            const current = localStorage.getItem("speechEnabled") === "true";
            const newState = !current;
            localStorage.setItem("speechEnabled", newState);
            updateIcon(newState);
        });

        function updateIcon(enabled) {
            if (enabled) {
                icon.classList.remove("bi-volume-mute");
                icon.classList.add("bi-volume-up-fill");
            } else {
                icon.classList.remove("bi-volume-up-fill");
                icon.classList.add("bi-volume-mute");
            }
        }
    });

    <% if params[:user_id].present? && params[:location_id].present? %>
    document.addEventListener("DOMContentLoaded", () => {
        async function speakText(user_id, location_id) {
            const response = await fetch("/tts", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ user_id: user_id, location_id: location_id })
            });

            if (response.status === 204) { // No TTS content
                return;
            } else if (!response.ok) {
                console.error(`HTTP error: ${response.status}`);
                return;
            }

            const audioData = await response.arrayBuffer();
            const blob = new Blob([audioData], { type: "audio/mpeg" });
            const url = URL.createObjectURL(blob);
            const audio = new Audio(url);
            audio.play();
        }

        const enabled = localStorage.getItem("speechEnabled") === "true";
        if (enabled) {
            speakText("<%= params[:user_id] %>", "<%= params[:location_id] %>");
        }
    });
    <% end %>
</script>
