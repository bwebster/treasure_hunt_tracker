<div class="container mt-5 pt-3">
  <%= render partial: "flash" %>

  <div class="card shadow-sm">
    <div class="card-header">
      <h4>RFID Tags</h4>
    </div>
    <div class="card-body">
      <% if @rfid_tags.any? %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
            <tr>
              <th>Tag ID</th>
              <th>Label</th>
              <th>Associated User</th>
              <th>Tracking Events</th>
            </tr>
            </thead>
            <tbody>
            <% @rfid_tags.each do |tag| %>
              <tr>
                <td>
                  <%= link_to tag.tag_id, edit_rfid_tag_path(tag) %>
                </td>
                <td><%= tag.label %></td>
                <td>
                  <% if tag.user.present? %>
                    <%= link_to tag.user.username || tag.user.auto_generated_name, edit_user_path(tag.user) %>
                  <% else %>
                    <span class="text-muted">Unassigned</span>
                  <% end %>
                </td>
                <td>
                  <%= tag.tracking_events.length %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>

        <div class="d-flex justify-content-center">
          <%= paginate @rfid_tags %>
        </div>
      <% else %>
        <p class="text-muted">No RFID tags found.</p>
      <% end %>
    </div>
  </div>
</div>
