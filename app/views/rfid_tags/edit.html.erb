<div class="container pt-3 mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Edit RFID Tag</h4>
    </div>
    <div class="card-body">
      <%= render partial: "flash" %>

      <% if @rfid_tag.errors.any? %>
        <div class="alert alert-danger">
          <h5><i class="bi bi-exclamation-triangle"></i> Please fix the following:</h5>
          <ul>
            <% @rfid_tag.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-5">
          <%= form_with model: @rfid_tag, local: true, data: { turbo: false } do |f| %>
            <input type="hidden" id="in-edit-registration-mode" name="registration_mode" value="false">

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :tag_id, class: "form-label" %>
                  <%= f.text_field :tag_id, class: "form-control", readonly: true %>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :label, class: "form-label" %>
                  <%= f.text_field :label, class: "form-control", id: "label-field" %>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-12">
                <hr/>
                <h5 class="mt-3">Assign to User</h5>

                <div class="mb-3 mt-3">
                  <%= f.label :new_username, "Enter User Name", class: "form-label" %>
                  <%= f.text_field :new_username, class: "form-control", id: "new-username" %>
                </div>

                <div class="mb-3">
                  <%= f.label :user_id, "of Pick Existing Users", class: "form-label" %>
                  <%= f.collection_select :user_id, @users, :id, :username, { include_blank: "Unassigned" }, class: "form-select" %>
                </div>
              </div>
            </div>

            <div class="text-start mt-3">
              <%= link_to "Cancel", rfid_tags_path, class: "btn btn-secondary rfid_tag_edit_cancel" %>
              <%= f.submit "Save Changes", class: "btn btn-primary" %>
            </div>

          <% end %>
        </div>
        <div class="col-7">
          <h5>Scoring</h5>
          <table class="table table-striped">
            <thead>
            <tr>
              <th>Scan</th>
              <th>Points</th>
              <th>Event</th>
              <th>Location</th>
            </tr>
            </thead>
            <tbody>
            <% @scores.each do |score| %>
            <tr>
              <td><%= score.source %></td>
              <td><%= score.score %></td>
              <td><%= score.event.name %></td>
              <td><%= score.location.name %></td>
            </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
    document.addEventListener("turbo:load", () => {
        const input = document.getElementById("new-username");
        if (input) {
            input.focus();
            input.select();
        }
    });
</script>