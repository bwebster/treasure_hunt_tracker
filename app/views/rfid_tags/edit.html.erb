<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Edit RFID Tag</h4>
    </div>
    <div class="card-body">
      <% if @rfid_tag.errors.any? %>
        <div class="alert alert-danger">
          <h5><i class="bi bi-exclamation-triangle"></i> Please fix the following:</h5>
          <ul>
            <% @rfid_tag.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

    <%= form_with model: @rfid_tag, local: true do |f| %>
        <input type="hidden" id="in-edit-registration-mode" name="registration_mode" value="false">

        <div class="mb-3">
          <%= f.label :tag_id, class: "form-label" %>
          <%= f.text_field :tag_id, class: "form-control", readonly: true %>
        </div>

        <div class="mb-3">
          <%= f.label :label, class: "form-label" %>
          <%= f.text_field :label, class: "form-control"  %>
        </div>

        <% if @rfid_tag.user.present? %>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <%= f.label :username, class: "form-label" %>
                <%= f.text_field :username, class: "form-control", readonly: true %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-check mb-3">
                <br/>
                  <%= f.check_box :remove_user, { class: "form-check-input" }, "1", "0" %>
                  <%= f.label :remove_user, "Remove User Association", class: "form-check-label" %>
              </div>
            </div>
          </div>
        <% else %>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <%= f.label :user_id, "Assign to User", class: "form-label" %>
                <%= f.collection_select :user_id, @users, :id, :username, { include_blank: "Unassigned" }, class: "form-select" %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <%= f.label :new_username, "...or Create a New User", class: "form-label" %>
                <%= f.text_field :new_username, class: "form-control"%>
              </div>
            </div>
          </div>
        <% end %>

        <div class="text-end">
          <%= link_to "Cancel", rfid_tags_path, class: "btn btn-secondary rfid_tag_edit_cancel" %>
          <%= f.submit "Save Changes", class: "btn btn-primary" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
