<div class="container pt-3 mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Edit RFID Tag: <%= @rfid_tag.tag_id %></h4>
    </div>
    <div class="card-body">
      <%= render partial: "flash" %>

      <% if @rfid_tag.errors.any? %>
        <div class="alert alert-danger">
          <h5><i class="bi bi-exclamation-triangle"></i> Please fix the following:</h5>
          <ul>
            <% @rfid_tag.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @rfid_tag, local: true, data: { turbo: false } do |f| %>
        <input type="hidden" id="in-edit-registration-mode" name="registration_mode" value="false">
        <input type="hidden"  name="user_id" value="<%= @user_id %>">
        <input type="hidden"  name="location_id" value="<%= @location_id %>">

        <div class="mt-3">
          <%= f.label :user_id, "Assigned user", class: "form-label" %>
          <%= f.select :user_id, options_from_collection_for_select(@users, :id, :username, @rfid_tag.user_id), { include_blank: "Unassigned" }, class: "form-select form-select-lg searchable-select" %>
          <% if @rfid_tag.user_id.present? %>
            <div class="form-text">
              <i class="bi bi-person-fill"></i>
              This RFID tag is owned by the following user.  Use the dropdown to change owners,
              or to unassign the current owner.
            </div>
          <% else %>
            <div class="form-text">
              <i class="bi bi-info-circle"></i>
              This RFID tag is not assigned to a user. Enter a new username above, or use
              the dropdown to assign to an existing user.
            </div>
          <% end %>
        </div>

        <div class="row mt-3">
          <div class="col-md-6">
            <div class="mb-3">
              <%= f.label :label, class: "form-label" %>
              <%= f.text_field :label, class: "form-control", id: "label-field" %>
              <div class="form-text">
                Labels are automatically generated, and used when there is no user assigned.
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <%= f.label :created_at, class: "form-label" %>
              <%= f.text_field :created_at, value: human_time(@rfid_tag.created_at), class: "form-control", id: "label-field", readonly: true %>
              <div class="form-text">
                Time when RFID tag was first scanned.
              </div>
            </div>
          </div>
        </div>

        <div class="text-end mt-3 mb-5">
          <%= link_to "Cancel", rfid_tags_path, class: "btn btn-secondary rfid_tag_edit_cancel" %>
          <%= f.submit "Save Changes", class: "btn btn-primary" %>
        </div>

      <% end %>

      <hr/>

      <h5>Scoring</h5>
      <table class="table table-striped">
        <thead>
        <tr>
          <th>Scanned At</th>
          <th>Score</th>
          <th>Score Type</th>
          <th>Source</th>
          <th>Event</th>
          <th>Location</th>
        </tr>
        </thead>
        <tbody>
        <% @scores.each do |score| %>
          <tr>
            <td><%= human_time(score.tracking_event.scanned_at) %></td>
            <td><%= score.score %></td>
            <td><%= score.score_type %></td>
            <td><%= score.source %></td>
            <td><%= score.event.name %></td>
            <td><%= score.location.name %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script>
    document.addEventListener("turbo:load", () => {
        const input = document.getElementById("new-username");
        if (input) {
            input.focus();
            input.select();
        }
    });
</script>