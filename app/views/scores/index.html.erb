<div class="container pt-3 mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Scores</h4>
    </div>
    <div class="card-body">
      <% if @scores.any? %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
            <tr>
              <th><%= sortable "tracking_event.scanned_at", title: "Scanned At", default: true %></th>
              <th><%= sortable "rfid_tag.label", title: "Tag Label" %></th>
              <th>Score</th>
              <th><%= sortable "score_type" %></th>
              <th>Source</th>
              <th><%= sortable "event.name", title: "Event" %></th>
              <th><%= sortable "location.name", title: "Location" %></th>
            </tr>
            </thead>
            <tbody>
            <% @scores.each do |score| %>
              <tr>
                <td><%= human_time(score.tracking_event.scanned_at) %></td>
                <td><%= score.rfid_tag.label %></td>
                <td><%= score.score %></td>
                <td><%= score.score_type %></td>
                <td><%= score.source %></td>
                <td><%= score.event.name %></td>
                <td><%= score.location.name %></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>

        <div class="d-flex justify-content-center">
          <%= paginate @scores %>
        </div>
      <% else %>
        <p class="text-muted">No tracking events found.</p>
      <% end %>
    </div>
  </div>
</div>
