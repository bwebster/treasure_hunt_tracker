<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Edit Location for <%= @event.name %></h4>
    </div>

    <div class="card-body">
      <% if @location.errors.any? %>
        <div class="alert alert-danger">
          <h5><i class="bi bi-exclamation-triangle"></i> Please fix the following:</h5>
          <ul>
            <% @location.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: [@event, @location], local: true do |f| %>

        <div class="mb-3">
          <%= f.label :number, "Station Number", class: "form-label" %>
          <%= f.select :number, unused_locations(@event, @location), {}, class: "form-select" %>
        </div>

        <div class="mb-3">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-control", required: true %>
        </div>

        <div class="form-check mb-3">
          <%= f.check_box :registration, class: "form-check-input" %>
          <%= f.label :registration, "Registration Location", class: "form-check-label" %>
        </div>

        <div class="form-check mb-3">
          <%= f.check_box :display, class: "form-check-input" %>
          <%= f.label :display, "Display Location", class: "form-check-label" %>
        </div>

        <div class="text-end">
          <%= link_to "Cancel", edit_event_path(@event), class: "btn btn-secondary" %>
          <%= f.submit "Save", class: "btn btn-primary" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
